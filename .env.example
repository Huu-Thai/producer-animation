# ============================================================
# Application
# ============================================================
NODE_ENV=development

# ============================================================
# Database (PostgreSQL 16 + pgvector)
# ============================================================
DATABASE_URL=postgresql://producer:producer@localhost:5432/producer_db

# ============================================================
# Redis 7
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# JWT Authentication (RS256)
# ============================================================
JWT_SECRET=change-this-to-a-very-long-random-secret-minimum-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-minimum-32-chars-different
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# AI Providers
# ============================================================
LEONARDO_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ============================================================
# YouTube OAuth 2.0
# ============================================================
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/channels/youtube/callback

# ============================================================
# AWS S3 / Storage
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=producer-animation-assets
AWS_REGION=us-east-1
CDN_BASE_URL=https://cdn.producer.dev

# ============================================================
# Encryption (AES-256 for OAuth tokens)
# ============================================================
OAUTH_ENCRYPTION_KEY=change-this-32-byte-encryption-key

# ============================================================
# Internal Services
# ============================================================
INTERNAL_SERVICE_SECRET=internal-secret-change-in-production
WORKFLOW_ENGINE_URL=http://localhost:3002
AI_GATEWAY_URL=http://localhost:3003

# ============================================================
# Observability (optional)
# ============================================================
SLACK_WEBHOOK_URL=

# Service Ports
API_PORT=3001
WORKFLOW_ENGINE_PORT=3002
AI_GATEWAY_PORT=3003
